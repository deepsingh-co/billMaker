# API
PORT=5000

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/barcodeDB

# Authentication
# Generate a long random value, for example: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=1d
JWT_REMEMBER_EXPIRES_IN=30d
